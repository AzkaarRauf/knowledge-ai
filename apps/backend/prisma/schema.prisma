// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  email         String         @unique
  googleId      String?        @unique
  role          Role           @default(USER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  department    Department     @relation(fields: [departmentId], references: [id])
  departmentId  String         @db.Uuid
  documents     Document[]
  conversations Conversation[]
  queryLogs     QueryLog[]
  feedback      Feedback[]
  auditLogs     AuditLog[]

  @@index([departmentId])
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Department {
  id            String         @id @default(uuid()) @db.Uuid
  name          String         @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  users         User[]
  documents     Document[]
  conversations Conversation[]
}

// set by the processing worker. only DONE docs have chunks
enum DocumentStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

model Document {
  id             String          @id @default(uuid()) @db.Uuid
  filename       String
  fileHash       String
  s3key          String
  status         DocumentStatus  @default(PENDING)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  documentChunks DocumentChunk[]
  user           User            @relation(fields: [userId], references: [id])
  userId         String          @db.Uuid
  conversation   Conversation?   @relation(fields: [conversationId], references: [id])
  conversationId String?         @db.Uuid
  department     Department?     @relation(fields: [departmentId], references: [id])
  departmentId   String?         @db.Uuid

  @@unique([fileHash, departmentId])
  @@index([userId])
  @@index([conversationId])
  @@index([departmentId])
  @@index([createdAt])
}

model DocumentChunk {
  id            String                     @id @default(uuid()) @db.Uuid
  document      Document                   @relation(fields: [documentId], references: [id])
  content       String
  metadata      Json
  embedding     Unsupported("vector(768)")
  // full-text search vector of content. set on insert with to_tsvector('english', content)
  contentSearch Unsupported("tsvector")?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  documentId    String                     @db.Uuid

  @@index([documentId])
  @@index([contentSearch], type: Gin)
}

model Conversation {
  id           String      @id @default(uuid()) @db.Uuid
  title        String      @default("New Chat")
  user         User        @relation(fields: [userId], references: [id])
  documents    Document[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  userId       String      @db.Uuid
  messages     Message[]
  queryLogs    QueryLog[]
  department   Department? @relation(fields: [departmentId], references: [id])
  departmentId String?     @db.Uuid

  @@index([userId, updatedAt])
  @@index([userId, createdAt])
  @@index([departmentId])
}

enum MessageRole {
  user
  assistant
  system
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  content        String
  role           MessageRole
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String       @db.Uuid
  feedback       Feedback[]

  @@index([conversationId, createdAt])
}

// one row per chat/search query. kept for analytics even after the conversation is deleted
model QueryLog {
  id             String        @id @default(uuid()) @db.Uuid
  user           User          @relation(fields: [userId], references: [id])
  userId         String        @db.Uuid
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  conversationId String?       @db.Uuid
  query          String
  // question after rewrite with chat history. null when no rewrite happened
  rewrittenQuery String?
  chunkCount     Int           @default(0)
  latencyMs      Int
  // set when the query failed
  error          String?
  createdAt      DateTime      @default(now())

  @@index([userId, createdAt])
  @@index([conversationId])
  @@index([createdAt])
}

enum FeedbackRating {
  UP
  DOWN
}

// thumbs up/down on an assistant message. one per user per message
model Feedback {
  id        String         @id @default(uuid()) @db.Uuid
  message   Message        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String         @db.Uuid
  user      User           @relation(fields: [userId], references: [id])
  userId    String         @db.Uuid
  rating    FeedbackRating
  comment   String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([messageId, userId])
  @@index([userId])
  @@index([createdAt])
}

enum AuditAction {
  DOCUMENT_UPLOADED
  DOCUMENT_DELETED
  CONVERSATION_DELETED
  USER_ROLE_CHANGED
  USER_DEPARTMENT_CHANGED
}

// who did what to which entity. entityId has no FK so the row stays after the entity is deleted
model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  actor      User        @relation(fields: [actorId], references: [id])
  actorId    String      @db.Uuid
  action     AuditAction
  entityType String
  entityId   String      @db.Uuid
  metadata   Json?
  createdAt  DateTime    @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@index([createdAt])
}
