{
    "name": "backend",
    "version": "0.0.1",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "type": "module",
    "scripts": {
        "build": "nest build",
        "deploy": "nest deploy",
        "format": "oxfmt src test",
        "format:check": "oxfmt --check src test",
        "start": "nest start",
        "dev": "nest start --watch --preserveWatchOutput --debug",
        "dev:debug": "nest start --debug --watch --preserveWatchOutput",
        "start:prod": "node dist/main",
        "lint": "oxlint --type-aware src/ test/ --fix",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:cov": "vitest run --coverage",
        "test:debug": "vitest --inspect-brk --no-file-parallelism",
        "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1149.0",
        "@aws-sdk/s3-request-presigner": "^3.1149.0",
