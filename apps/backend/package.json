        "rxjs": "^7.8.1",
        "shared": "workspace:*",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@nestjs/cli": "^12.0.0",
        "@nestjs/mau": "^0.2.6",
        "@nestjs/schematics": "^12.0.0",
        "@nestjs/testing": "^12.0.1",
        "@types/bcrypt": "^6.0.0",
