# Port the backend server listens on (default: 8090)
PORT=8090

# Runtime environment: dev | prod (required)
ENV=dev

# Database connection URL (required)
DATABASE_URL=

# Email of the admin user created by the seed script (optional)
# SEED_ADMIN_EMAIL=

# Password of the seeded admin user (optional)
# 8-50 chars, with at least one uppercase, lowercase, number and special character
# SEED_ADMIN_PASSWORD=

# Secret used to sign JWT access tokens (required)
JWT_SECRET=
