# Port the backend server listens on (default: 8090)
PORT=8090

# Runtime environment: dev | prod (required)
ENV=dev

# Database connection URL (required)
DATABASE_URL=

# Email of the admin user created by the seed script (optional)
# SEED_ADMIN_EMAIL=

# Secret used to sign JWT access tokens (required)
JWT_SECRET=

# Google AI (Gemini) API key, used to create document embeddings (required)
GOOGLE_API_KEY=

# S3-compatible storage endpoint URL (required)
AWS_ENDPOINT_URL_S3=

# Access key ID for S3 storage (required)
AWS_ACCESS_KEY_ID=

# Secret access key for S3 storage (required)
AWS_SECRET_ACCESS_KEY=

# Region of the S3 storage, e.g. auto or us-east-1 (required)
AWS_REGION=

# Name of the S3 bucket where documents are stored (required)
S3_BUCKET=

# Google OAuth client ID, from Google Auth Platform > Clients (required)
GOOGLE_CLIENT_ID=

# Google OAuth client secret (required)
GOOGLE_CLIENT_SECRET=

# Google OAuth callback URL, on the frontend origin. Must match the console exactly (required)
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# Comma separated Google Workspace domains allowed to sign in, e.g. acme.com,acme.io (required)
ALLOWED_DOMAINS=
