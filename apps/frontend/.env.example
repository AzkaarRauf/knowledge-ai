# Base URL for backend API calls. Defaults to /api/v1, proxied to the Nest backend by next.config.ts rewrites.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Backend origin that /api and /health are proxied to (no trailing slash). Read at build time. Defaults to http://localhost:8090
# BACKEND_URL=http://localhost:8090

# Public origin of the site, e.g. https://app.example.com. Used for metadataBase. Omit to skip it (optional)
# NEXT_PUBLIC_SITE_URL=
