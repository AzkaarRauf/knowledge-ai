# Base URL for backend API calls. Defaults to /api/v1, proxied to the Nest backend by next.config.ts rewrites.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Backend origin (no trailing slash). Defaults to http://localhost:8090
# Read at build time for the /api and /health rewrites, and at runtime by /cold-start/status to detect a sleeping backend.
# Server-only: set it in the host's runtime env too, not just at build.
# BACKEND_URL=http://localhost:8090

# Public origin of the site, e.g. https://app.example.com. Used for metadataBase. Omit to skip it (optional)
# NEXT_PUBLIC_SITE_URL=
