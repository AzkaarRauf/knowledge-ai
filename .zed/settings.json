{
    "tab_size": 4,
    "lsp": {
        // use the repo's TS (5.9.x) so editor errors match `pnpm typecheck`.
        // TS 6+ misses unknown fields in Prisma `data` objects, so stay on 5.9 for now.
        "vtsls": {
            "settings": {
                "typescript": {
                    "tsdk": "apps/backend/node_modules/typescript/lib"
                }
            }
        }
    },
    "languages": {
        "JavaScript": {
            "format_on_save": "on",
            "prettier": {
                "allowed": false
            },
            "formatter": [
                {
                    "language_server": {
                        "name": "oxfmt"
                    }
                },
                {
                    "code_action": "source.fixAll.oxc"
                }
            ]
        },
        "TypeScript": {
            "format_on_save": "on",
